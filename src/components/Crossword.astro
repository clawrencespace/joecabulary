---
import type { Puzzle } from "../data/puzzles";

interface Props {
  puzzle: Puzzle;
}

const { puzzle } = Astro.props;

type Cell = {
  row: number;
  col: number;
  solution: string;
  number?: number;
  entries: number[];
};

const cellMap = new Map<string, Cell>();
for (const entry of puzzle.entries) {
  [...entry.answer].forEach((letter, index) => {
    const row = entry.row + (entry.direction === "down" ? index : 0);
    const col = entry.col + (entry.direction === "across" ? index : 0);
    const key = `${row}-${col}`;
    const existing = cellMap.get(key);
    cellMap.set(key, {
      row,
      col,
      solution: letter,
      number: existing?.number ?? (index === 0 ? entry.number : undefined),
      entries: [...(existing?.entries ?? []), entry.number],
    });
  });
}

const cells = Array.from({ length: puzzle.size * puzzle.size }, (_, index) => {
  const row = Math.floor(index / puzzle.size);
  const col = index % puzzle.size;
  return cellMap.get(`${row}-${col}`) ?? null;
});

const across = puzzle.entries.filter((entry) => entry.direction === "across");
const down = puzzle.entries.filter((entry) => entry.direction === "down");
---

<section class="crossword-shell" data-crossword data-puzzle={puzzle.slug}>
  <div class="crossword-shell__header">
    <div>
      <p class="kicker">{puzzle.eyebrow}</p>
      <h1>{puzzle.title}</h1>
      <p class="crossword-shell__date">{puzzle.date}</p>
    </div>
    <div class="crossword-progress" aria-live="polite">
      <span data-progress>0%</span>
      <small>complete</small>
    </div>
  </div>

  <div class="crossword-layout">
    <div class="crossword-board-wrap">
      <div
        class="crossword-board"
        style={`--grid-size: ${puzzle.size}`}
        aria-label={`${puzzle.title} crossword grid`}
      >
        {
          cells.map((cell, index) =>
            cell ? (
              <label
                class="crossword-cell"
                data-cell
                data-row={cell.row}
                data-col={cell.col}
                data-entries={cell.entries.join(",")}
              >
                {cell.number && <span>{cell.number}</span>}
                <input
                  aria-label={`Row ${cell.row + 1}, column ${cell.col + 1}`}
                  inputmode="text"
                  autocapitalize="characters"
                  autocomplete="off"
                  spellcheck="false"
                  data-solution={cell.solution}
                />
              </label>
            ) : (
              <div class="crossword-block" aria-hidden="true" data-index={index}></div>
            )
          )
        }
      </div>

      <div class="crossword-actions">
        <button class="button button--ink" type="button" data-check>Check puzzle</button>
        <button class="text-button" type="button" data-clear>Clear</button>
        <span data-message aria-live="polite"></span>
      </div>
    </div>

    <div class="crossword-clues">
      <div>
        <h2>Across</h2>
        <ol>
          {
            across.map((entry) => (
              <li>
                <button type="button" data-clue={entry.number}>
                  <b>{entry.number}</b>
                  <span>{entry.clue}</span>
                </button>
              </li>
            ))
          }
        </ol>
      </div>
      <div>
        <h2>Down</h2>
        <ol>
          {
            down.map((entry) => (
              <li>
                <button type="button" data-clue={entry.number}>
                  <b>{entry.number}</b>
                  <span>{entry.clue}</span>
                </button>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>

<script>
  const roots = document.querySelectorAll<HTMLElement>("[data-crossword]");

  roots.forEach((root) => {
    const inputs = Array.from(root.querySelectorAll<HTMLInputElement>("input"));
    const cells = Array.from(root.querySelectorAll<HTMLElement>("[data-cell]"));
    const storageKey = `joecabulary:${root.dataset.puzzle}`;
    const message = root.querySelector<HTMLElement>("[data-message]");
    const progress = root.querySelector<HTMLElement>("[data-progress]");
    let activeEntry = 1;

    const cellKey = (input: HTMLInputElement) => {
      const cell = input.closest<HTMLElement>("[data-cell]");
      return cell ? `${cell.dataset.row}-${cell.dataset.col}` : "";
    };

    const save = () => {
      const letters = Object.fromEntries(
        inputs
          .map((input) => [cellKey(input), input.value])
          .filter(([key]) => key)
      );
      localStorage.setItem(storageKey, JSON.stringify({ version: 2, letters }));
    };

    const updateProgress = () => {
      const filled = inputs.filter((input) => input.value).length;
      const percent = Math.round((filled / inputs.length) * 100);
      if (progress) progress.textContent = `${percent}%`;
    };

    const selectInput = (input: HTMLInputElement) => {
      requestAnimationFrame(() => input.select());
    };

    const highlightEntry = (entryNumber: number) => {
      activeEntry = entryNumber;
      cells.forEach((cell) => {
        const entries = cell.dataset.entries?.split(",").map(Number) ?? [];
        cell.classList.toggle("is-highlighted", entries.includes(entryNumber));
      });
      root.querySelectorAll("[data-clue]").forEach((clue) => {
        clue.classList.toggle(
          "is-active",
          Number((clue as HTMLElement).dataset.clue) === entryNumber
        );
      });
    };

    const saved = localStorage.getItem(storageKey);
    if (saved) {
      try {
        const state = JSON.parse(saved) as {
          version?: number;
          letters?: Record<string, string>;
        };

        if (state.version === 2 && state.letters) {
          inputs.forEach((input) => {
            input.value = state.letters?.[cellKey(input)] ?? "";
          });
        }
      } catch {
        // The original save format discarded empty squares, so a partial puzzle
        // cannot be restored reliably. A fully filled legacy puzzle is safe.
        if (saved.length === inputs.length) {
          inputs.forEach((input, index) => {
            input.value = saved[index] ?? "";
          });
          save();
        } else {
          localStorage.removeItem(storageKey);
        }
      }
    }

    inputs.forEach((input) => {
      input.addEventListener("focus", () => {
        const cell = input.closest<HTMLElement>("[data-cell]");
        const entries = cell?.dataset.entries?.split(",").map(Number) ?? [];
        if (!entries.includes(activeEntry)) highlightEntry(entries[0]);
        selectInput(input);
      });

      input.addEventListener("click", () => {
        selectInput(input);
      });

      input.addEventListener("beforeinput", (event) => {
        if (event.inputType !== "insertText" || !event.data) return;
        const letter = event.data.match(/[a-z]/i)?.[0];
        if (!letter) return;
        event.preventDefault();
        input.value = letter.toUpperCase();
        input.dispatchEvent(new Event("input", { bubbles: true }));
      });

      input.addEventListener("input", () => {
        input.value = input.value.replace(/[^a-z]/gi, "").slice(-1).toUpperCase();
        input.closest("[data-cell]")?.classList.remove("is-wrong", "is-correct");
        save();
        updateProgress();

        if (!input.value) return;
        const currentCell = input.closest<HTMLElement>("[data-cell]");
        const entryCells = cells.filter((cell) =>
          cell.dataset.entries?.split(",").map(Number).includes(activeEntry)
        );
        const currentIndex = entryCells.indexOf(currentCell!);
        const nextInput = entryCells[currentIndex + 1]?.querySelector<HTMLInputElement>("input");
        nextInput?.focus();
      });

      input.addEventListener("keydown", (event) => {
        if (event.key !== "Backspace" || input.value) return;
        const currentCell = input.closest<HTMLElement>("[data-cell]");
        const entryCells = cells.filter((cell) =>
          cell.dataset.entries?.split(",").map(Number).includes(activeEntry)
        );
        const currentIndex = entryCells.indexOf(currentCell!);
        entryCells[currentIndex - 1]?.querySelector<HTMLInputElement>("input")?.focus();
      });
    });

    root.querySelectorAll<HTMLButtonElement>("[data-clue]").forEach((clue) => {
      clue.addEventListener("click", () => {
        const entryNumber = Number(clue.dataset.clue);
        highlightEntry(entryNumber);
        cells
          .find((cell) => cell.dataset.entries?.split(",").map(Number).includes(entryNumber))
          ?.querySelector<HTMLInputElement>("input")
          ?.focus();
      });
    });

    root.querySelector("[data-check]")?.addEventListener("click", () => {
      let wrong = 0;
      let empty = 0;
      inputs.forEach((input) => {
        const cell = input.closest<HTMLElement>("[data-cell]");
        cell?.classList.remove("is-wrong", "is-correct");
        if (!input.value) {
          empty += 1;
        } else if (input.value === input.dataset.solution) {
          cell?.classList.add("is-correct");
        } else {
          wrong += 1;
          cell?.classList.add("is-wrong");
        }
      });

      if (!message) return;
      if (!wrong && !empty) {
        message.textContent = "Clean solve. Nicely done.";
      } else if (wrong) {
        message.textContent = `${wrong} square${wrong === 1 ? "" : "s"} need another look.`;
      } else {
        message.textContent = "Everything filled so far checks out.";
      }
    });

    root.querySelector("[data-clear]")?.addEventListener("click", () => {
      if (!window.confirm("Clear your saved progress for this puzzle?")) return;
      inputs.forEach((input) => {
        input.value = "";
        input.closest("[data-cell]")?.classList.remove("is-wrong", "is-correct");
      });
      localStorage.removeItem(storageKey);
      if (message) message.textContent = "";
      updateProgress();
    });

    highlightEntry(activeEntry);
    updateProgress();
  });
</script>
