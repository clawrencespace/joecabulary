---
import type { WordEntry } from "../data/words";

interface Props {
  entry: WordEntry;
  index: number;
}

const { entry, index } = Astro.props;
---

<article class="word-card reveal" style={`--delay: ${index * 90}ms`}>
  <div class="word-card__topline">
    <span class="word-card__number">{String(index + 1).padStart(2, "0")}</span>
    <div class="word-card__tags">
      {(entry.tags ?? []).map((tag) => <span>{tag}</span>)}
    </div>
  </div>
  <h3>{entry.word}</h3>
  {entry.partOfSpeech && <p class="word-card__meta"><em>{entry.partOfSpeech}</em></p>}
  <p class="word-card__definition">{entry.definition}</p>
  <details>
    <summary>Go deeper <span aria-hidden="true">↘</span></summary>
    <div class="word-card__details">
      <div class="pronunciation-details">
        <strong>Pronunciation</strong>
        <p><span>IPA</span><code>/{entry.ipa}/</code></p>
        <p><span>American</span>{entry.pronunciation}</p>
        <p><span>Sounds like</span>{entry.soundsLike}</p>
      </div>
      <p><strong>Roots</strong>{entry.origin}</p>
      <p><strong>Nuance</strong>{entry.nuance}</p>
      <blockquote>“{entry.example}”</blockquote>
    </div>
  </details>
</article>
