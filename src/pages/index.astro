---
import BaseLayout from "../layouts/BaseLayout.astro";
import WordCard from "../components/WordCard.astro";
import {
  archiveWords,
  editionCount,
  recentWords,
  todayWords,
  wordCount,
} from "../data/words";

const miniGridBlocks = [0, 6, 8, 12, 14, 18, 24, 30, 34, 36, 40, 42, 48];
const miniGridNumbers: Record<number, number> = { 1: 1, 7: 2, 15: 3, 21: 4, 37: 5 };
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
  title="Joecabulary · Four useful words every day"
  description="A daily collection of useful vocabulary, plus a fresh crossword every Sunday."
>
  <section class="hero">
    <div class="hero__date reveal">
      <span>Thursday</span>
      <b>18</b>
      <span>June 2026</span>
    </div>
    <div class="hero__copy reveal" style="--delay: 100ms">
      <p class="kicker">Today’s edition</p>
      <h1>Four words worth<br /><em>keeping around.</em></h1>
      <p>
        Useful language for sharper thinking, clearer writing, and the occasional
        perfectly timed sentence.
      </p>
      <a class="button button--coral" href="#today">Read today’s words <span>↓</span></a>
    </div>
    <aside class="hero__marginalia reveal" style="--delay: 200ms">
      <p><span>{wordCount}</span> words collected</p>
      <p><span>{editionCount}</span> daily editions</p>
      <p><span>01</span> Sunday puzzle</p>
    </aside>
    <div class="hero__scribble" aria-hidden="true">Words make worlds.</div>
  </section>

  <section class="today-section" id="today">
    <div class="section-heading">
      <div>
        <p class="kicker">June 18 · Edition No. 019</p>
        <h2>Today’s words</h2>
      </div>
      <p>
        A compass point, a judgment, a multiplicity, and the thing that cannot be
        simplified away.
      </p>
    </div>
    <div class="word-grid">
      {todayWords.map((entry, index) => <WordCard entry={entry} index={index} />)}
    </div>
  </section>

  <section class="crossword-feature">
    <div class="crossword-feature__stamp" aria-hidden="true">
      <span>New</span>
      <strong>Every<br />Sunday</strong>
    </div>
    <div class="crossword-feature__copy">
      <p class="kicker">The Sunday crossword</p>
      <h2>The week’s words,<br />put to work.</h2>
      <p>
        A compact crossword built from the strongest vocabulary of the week.
        Definitions help. Understanding helps more.
      </p>
      <a class="button button--paper" href={`${base}/crosswords/preview-001`}>
        Play the preview <span>↗</span>
      </a>
    </div>
    <a class="mini-grid" href={`${base}/crosswords/preview-001`} aria-label="Play the crossword preview">
      {
        Array.from({ length: 49 }, (_, index) => (
          <span class:list={{ "is-block": miniGridBlocks.includes(index) }}>
            {miniGridNumbers[index] && <i>{miniGridNumbers[index]}</i>}
          </span>
        ))
      }
      <b>Play</b>
    </a>
  </section>

  <section class="recent-section">
    <div class="section-heading section-heading--compact">
      <div>
        <p class="kicker">From the archive</p>
        <h2>Recently added</h2>
      </div>
      <a class="text-link" href={`${base}/words`}>Browse all {wordCount} words <span>→</span></a>
    </div>
    <div class="recent-list">
      {
        recentWords.slice(0, 6).map((entry, index) => (
          <article>
            <span>{String(archiveWords.length - 4 - index).padStart(3, "0")}</span>
            <div>
              <h3>{entry.word}</h3>
              <p>{entry.note}</p>
            </div>
            <time>{entry.date}</time>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
