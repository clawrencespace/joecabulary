---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Crossword from "../../components/Crossword.astro";
import { allPuzzles } from "../../data/puzzles";

export function getStaticPaths() {
  return allPuzzles.map((puzzle) => ({
    params: { slug: puzzle.slug },
    props: { puzzle },
  }));
}

const { puzzle } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
  title={`${puzzle.title} · Joecabulary Crossword`}
  description={`Play ${puzzle.title}, a Joecabulary Sunday crossword.`}
>
  <div class="puzzle-page">
    <div class="puzzle-page__toolbar">
      <a class="back-link" href={`${base}/crosswords`}>← All crosswords</a>
      <button
        class="share-button"
        type="button"
        data-share
        data-share-title={`${puzzle.title} · Joecabulary`}
        data-share-text={`Play ${puzzle.title}, a Joecabulary Sunday crossword.`}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="18" cy="5" r="2.5"></circle>
          <circle cx="6" cy="12" r="2.5"></circle>
          <circle cx="18" cy="19" r="2.5"></circle>
          <path d="m8.2 10.8 7.6-4.5M8.2 13.2l7.6 4.5"></path>
        </svg>
        <span>Share puzzle</span>
      </button>
    </div>
    <Crossword puzzle={puzzle} />
    <aside class="puzzle-note">
      <p class="kicker">After the solve</p>
      <h2>The words stay useful.</h2>
      <p>
        In the finished version, each featured answer will unlock its complete
        glossary card: roots, nuance, and the original example from the daily edition.
      </p>
    </aside>
  </div>
</BaseLayout>
