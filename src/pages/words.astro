---
import BaseLayout from "../layouts/BaseLayout.astro";
import { archiveWords } from "../data/words";

const displayDate = new Intl.DateTimeFormat("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
---

<BaseLayout
  title="Word Archive · Joecabulary"
  description="Browse the growing Joecabulary archive of useful words."
>
  <section class="archive-hero">
    <p class="kicker">The word archive</p>
    <h1>Every word,<br /><em>still within reach.</em></h1>
    <div class="archive-search">
      <label for="word-search">Search the collection</label>
      <div>
        <input id="word-search" type="search" placeholder="Try “leadership” or “germane”" />
        <span>⌕</span>
      </div>
    </div>
  </section>

  <section class="archive-section">
    <div class="archive-toolbar">
      <p><strong data-visible-count>{archiveWords.length}</strong> words in the archive</p>
      <div>
        <button class="is-active" type="button" data-sort="newest">Newest</button>
        <button type="button" data-sort="alpha">A–Z</button>
      </div>
    </div>
    <div class="archive-grid" data-word-list>
      {
        archiveWords.map((entry, index) => (
          <details
            class="archive-card"
            data-word={`${entry.word} ${entry.pronunciation ?? ""} ${entry.ipa ?? ""} ${entry.soundsLike ?? ""} ${entry.definition} ${entry.origin} ${entry.nuance} ${entry.example}`.toLowerCase()}
            data-date={entry.date}
            data-name={entry.word.toLowerCase()}
            data-index={index}
          >
            <summary>
              <span class="archive-card__number">
                {String(archiveWords.length - index).padStart(3, "0")}
              </span>
              <div class="archive-card__intro">
                <h2>{entry.word}</h2>
                <p>{entry.definition}</p>
              </div>
              <time datetime={entry.date}>
                {displayDate.format(new Date(`${entry.date}T00:00:00Z`))}
              </time>
              <span class="archive-card__toggle" aria-hidden="true">↓</span>
            </summary>
            <div class="archive-card__body">
              <div class="pronunciation-details">
                <strong>Pronunciation</strong>
                <p><span>IPA</span><code>/{entry.ipa}/</code></p>
                <p><span>American</span>{entry.pronunciation}</p>
                <p><span>Sounds like</span>{entry.soundsLike}</p>
              </div>
              <div>
                <strong>Origin</strong>
                <p>{entry.origin}</p>
              </div>
              <div>
                <strong>Nuance</strong>
                <p>{entry.nuance}</p>
              </div>
              <blockquote>“{entry.example}”</blockquote>
            </div>
          </details>
        ))
      }
    </div>
    <p class="empty-state" data-empty hidden>No words matched that search.</p>
  </section>

  <script>
    const search = document.querySelector<HTMLInputElement>("#word-search");
    const list = document.querySelector<HTMLElement>("[data-word-list]");
    const cards = Array.from(document.querySelectorAll<HTMLDetailsElement>("[data-word]"));
    const empty = document.querySelector<HTMLElement>("[data-empty]");
    const visibleCount = document.querySelector<HTMLElement>("[data-visible-count]");
    const sortButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-sort]"));

    const filterCards = () => {
      const query = search?.value.trim().toLowerCase() ?? "";
      let visible = 0;
      cards.forEach((card) => {
        const match = card.dataset.word?.includes(query) ?? false;
        card.hidden = !match;
        if (match) visible += 1;
      });
      if (empty) empty.hidden = visible > 0;
      if (visibleCount) visibleCount.textContent = String(visible);
    };

    search?.addEventListener("input", filterCards);

    sortButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const mode = button.dataset.sort;
        const sorted = [...cards].sort((a, b) => {
          if (mode === "alpha") {
            return (a.dataset.name ?? "").localeCompare(b.dataset.name ?? "");
          }
          const dateOrder = (b.dataset.date ?? "").localeCompare(a.dataset.date ?? "");
          if (dateOrder !== 0) return dateOrder;
          return Number(a.dataset.index) - Number(b.dataset.index);
        });

        sorted.forEach((card) => list?.append(card));
        sortButtons.forEach((item) => item.classList.toggle("is-active", item === button));
      });
    });
  </script>
</BaseLayout>
